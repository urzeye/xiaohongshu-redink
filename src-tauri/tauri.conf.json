{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RedInk",
  "version": "0.4.0",
  "identifier": "com.redink.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir frontend dev",
    "beforeBuildCommand": "pnpm --dir frontend build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RedInk · 小红书 AI 爆款创作引擎",
        "width": 1360,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../backend/": "backend/",
      "../data/template.json": "data/template.json",
      "../pyproject.toml": "pyproject.toml",
      "../alembic.ini": "alembic.ini",
      "../text_providers.yaml.example": "text_providers.yaml.example",
      "../image_providers.yaml.example": "image_providers.yaml.example",
      "../search_providers.yaml.example": "search_providers.yaml.example",
      "../.env.example": ".env.example"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "小红书 AI 爆款图文创作与本地安全发布工具",
    "longDescription": "RedInk (红墨) · 本地家庭宽带环境一键生成并发布多图文到小红书",
    "copyright": "CC BY-NC-SA 4.0",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
